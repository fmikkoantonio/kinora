{
  "expo": {
    "name": "Kinora",
    "slug": "kinora",
    "scheme": ["kinora"],
    "version": "1.1.0",
    "icon": "./assets/images/kinora-icon.png",
    "splash": {
      "image": "./assets/images/kinora-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.fmga.kinora",
      "buildNumber": "2",
      "icon": "./assets/images/kinora-icon.png"
    },
    "android": {
      "package": "com.fmga.kinora",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kinora-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/kinora-icon.png"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-font", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
